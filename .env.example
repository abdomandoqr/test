# Clinic environment variables
# The CLINIC_* values below are substituted into bot replies. If left empty,
# the bot falls back to safe demo values so onboarding and FAQ still work.

# Telegram
TELEGRAM_BOT_TOKEN=

# Gemini
GEMINI_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clinic profile (client-customizable)
CLINIC_NAME=
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_HOURS=
CLINIC_SERVICES=
CLINIC_FIRST_VISIT_NOTES=
CLINIC_EMERGENCY_NOTE=

# Clinic booking rules
CLINIC_TIMEZONE=Africa/Cairo
DEFAULT_SLOT_MINUTES=30
BOOKING_LEAD_HOURS=2
MAX_ACTIVE_APPOINTMENTS=1
REMINDER_ENABLED=true
REMINDER_HOURS_BEFORE=24,1
REMINDER_CRON_MINUTES=5

# future – not required now (WhatsApp Cloud API)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
